{
  "$defs": {
    "ApparatusIdentityModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ApparatusIdentityModel",
      "type": "object"
    },
    "ExperimentApparatusComponentModel": {
      "additionalProperties": false,
      "properties": {
        "compatibility_refs": {
          "items": {
            "$ref": "#/$defs/ExperimentReferenceModel"
          },
          "title": "Compatibility Refs",
          "type": "array"
        },
        "component_kind": {
          "enum": [
            "processor",
            "backend",
            "participant-implementation",
            "host",
            "container",
            "vm",
            "network",
            "device",
            "measurement-channel",
            "other"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ApparatusIdentityModel"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "manifest_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperimentManifestReferenceModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        }
      },
      "required": [
        "component_kind",
        "identity"
      ],
      "title": "ExperimentApparatusComponentModel",
      "type": "object"
    },
    "ExperimentArtifactRefModel": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperimentChecksumModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "media_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "role": {
          "enum": [
            "protocol",
            "metric-definition",
            "scenario-snapshot",
            "manifest",
            "apparatus-evidence",
            "observation",
            "result",
            "analysis",
            "report",
            "export",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "restricted",
            "redacted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ExperimentArtifactRefModel",
      "type": "object"
    },
    "ExperimentChecksumModel": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "minLength": 1,
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "ExperimentChecksumModel",
      "type": "object"
    },
    "ExperimentClockContextModel": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "clock_id": {
          "minLength": 1,
          "title": "Clock Id",
          "type": "string"
        },
        "synchronization": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synchronization"
        },
        "time_domain": {
          "enum": [
            "wall-clock",
            "monotonic",
            "simulated",
            "logical",
            "other"
          ],
          "title": "Time Domain",
          "type": "string"
        }
      },
      "required": [
        "clock_id",
        "authority",
        "time_domain"
      ],
      "title": "ExperimentClockContextModel",
      "type": "object"
    },
    "ExperimentManifestReferenceModel": {
      "additionalProperties": false,
      "description": "Reference constrained to an apparatus or capability manifest.",
      "properties": {
        "ref_digest": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Digest"
        },
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "ref_kind": {
          "const": "manifest",
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Path"
        },
        "ref_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Version"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "ExperimentManifestReferenceModel",
      "type": "object"
    },
    "ExperimentParameterModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "redaction": {
          "default": "none",
          "enum": [
            "none",
            "redacted",
            "withheld"
          ],
          "title": "Redaction",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_kind": {
          "enum": [
            "configuration",
            "protocol",
            "apparatus",
            "analysis",
            "other"
          ],
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "value_kind"
      ],
      "title": "ExperimentParameterModel",
      "type": "object"
    },
    "ExperimentReferenceModel": {
      "additionalProperties": false,
      "description": "Typed reference to an experiment-core or adjacent ACES artifact.",
      "properties": {
        "ref_digest": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Digest"
        },
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "ref_kind": {
          "enum": [
            "scenario",
            "scenario-snapshot",
            "task",
            "protocol",
            "apparatus-context",
            "run",
            "result",
            "study",
            "manifest",
            "profile",
            "evidence",
            "analysis-artifact",
            "other"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Path"
        },
        "ref_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Version"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "ExperimentReferenceModel",
      "type": "object"
    },
    "ExperimentStochasticControlModel": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "minLength": 1,
          "title": "Control Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "role": {
          "enum": [
            "seed",
            "randomization",
            "sampling",
            "scheduler",
            "agent-policy",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "control_id",
        "role"
      ],
      "title": "ExperimentStochasticControlModel",
      "type": "object"
    },
    "ExperimentValidityNoteModel": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "construct",
            "internal",
            "external",
            "conclusion",
            "statistical",
            "apparatus",
            "reproducibility",
            "security",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "mitigation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mitigation"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "category",
        "note"
      ],
      "title": "ExperimentValidityNoteModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apparatus_context_id": {
      "minLength": 1,
      "title": "Apparatus Context Id",
      "type": "string"
    },
    "clocks": {
      "items": {
        "$ref": "#/$defs/ExperimentClockContextModel"
      },
      "title": "Clocks",
      "type": "array"
    },
    "compatibility_declarations": {
      "items": {
        "$ref": "#/$defs/ExperimentReferenceModel"
      },
      "title": "Compatibility Declarations",
      "type": "array"
    },
    "components": {
      "additionalProperties": {
        "$ref": "#/$defs/ExperimentApparatusComponentModel"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Components",
      "type": "object"
    },
    "configuration_parameters": {
      "items": {
        "$ref": "#/$defs/ExperimentParameterModel"
      },
      "title": "Configuration Parameters",
      "type": "array"
    },
    "context_version": {
      "minLength": 1,
      "title": "Context Version",
      "type": "string"
    },
    "declared_at": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared At"
    },
    "known_limitations": {
      "items": {
        "$ref": "#/$defs/ExperimentValidityNoteModel"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "measurement_channels": {
      "items": {
        "$ref": "#/$defs/ExperimentReferenceModel"
      },
      "title": "Measurement Channels",
      "type": "array"
    },
    "observed_setup_evidence": {
      "items": {
        "$ref": "#/$defs/ExperimentArtifactRefModel"
      },
      "title": "Observed Setup Evidence",
      "type": "array"
    },
    "schema_version": {
      "const": "experiment-apparatus-context/v1",
      "default": "experiment-apparatus-context/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_manifests": {
      "items": {
        "$ref": "#/$defs/ExperimentManifestReferenceModel"
      },
      "title": "Selected Manifests",
      "type": "array"
    },
    "stochastic_controls": {
      "items": {
        "$ref": "#/$defs/ExperimentStochasticControlModel"
      },
      "title": "Stochastic Controls",
      "type": "array"
    }
  },
  "required": [
    "apparatus_context_id",
    "context_version",
    "components"
  ],
  "title": "ExperimentApparatusContextModel",
  "type": "object"
}
