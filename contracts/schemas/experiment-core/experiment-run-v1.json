  "$id": "https://aces.dev/schemas/experiment-run-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "run_status": {
            "const": "invalidated"
          }
        },
        "required": [
          "run_status"
        ]
      },
      "then": {
        "properties": {
          "invalidation": {
            "type": "object"
          }
        },
        "required": [
          "invalidation"
        ]
      }
    }
  ],
  "description": "Archival provenance record for one execution of an experiment task.",
  "properties": {
    "apparatus_context": {
      "$ref": "#/$defs/ExperimentApparatusContextModel"
    },
    "clock_context": {
      "$ref": "#/$defs/ExperimentClockContextModel"
