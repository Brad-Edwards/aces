    "ended_at": {
      "format": "date-time",
      "minLength": 1,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "title": "Ended At",
      "type": "string"
    },
    "evidence_artifacts": {
