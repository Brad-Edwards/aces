        {
          "$ref": "#/$defs/ExperimentInvalidationModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome_status": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "inconclusive",
        "not-evaluated"
      ],
      "title": "Outcome Status",
      "type": "string"
    },
    "parameter_set": {
      "items": {
        "$ref": "#/$defs/ExperimentParameterModel"
      },
      "minItems": 1,
      "title": "Parameter Set",
      "type": "array"
    },
    "result_summaries": {
      "additionalProperties": {
        "$ref": "#/$defs/ExperimentResultSummaryModel"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Result Summaries",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "sealed",
        "completed",
        "failed",
        "aborted",
        "invalidated",
        "superseded"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "run_version": {
      "minLength": 1,
      "title": "Run Version",
      "type": "string"
    },
    "scenario_snapshot_ref": {
      "$ref": "#/$defs/ExperimentScenarioSnapshotReferenceModel"
    },
    "schema_version": {
      "const": "experiment-run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "minLength": 1,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "title": "Started At",
      "type": "string"
    },
    "stochastic_controls": {
      "items": {
        "$ref": "#/$defs/ExperimentStochasticControlModel"
      },
      "minItems": 1,
      "title": "Stochastic Controls",
      "type": "array"
    },
    "task_ref": {
      "$ref": "#/$defs/ExperimentTaskReferenceModel"
    },
    "used_refs": {
      "items": {
        "$ref": "#/$defs/ExperimentReferenceModel"
      },
      "title": "Used Refs",
      "type": "array"
    }
  },
  "required": [
