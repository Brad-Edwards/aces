{
  "$defs": {
    "PropositionAssertionPolarity": {
      "enum": [
        "positive",
        "negative"
      ],
      "title": "PropositionAssertionPolarity",
      "type": "string"
    },
    "PropositionEvaluationBasis": {
      "enum": [
        "declared_state",
        "observed_state"
      ],
      "title": "PropositionEvaluationBasis",
      "type": "string"
    },
    "PropositionIndeterminacyReason": {
      "enum": [
        "missing_evidence",
        "stale_evidence",
        "partial_evidence",
        "conflicting_evidence",
        "redacted_evidence",
        "lossy_evidence",
        "probe_failure"
      ],
      "title": "PropositionIndeterminacyReason",
      "type": "string"
    },
    "PropositionLossDisclosureModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PropositionLossKind"
        },
        "within_admissible_bound": {
          "title": "Within Admissible Bound",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "within_admissible_bound"
      ],
      "title": "PropositionLossDisclosureModel",
      "type": "object"
    },
    "PropositionLossKind": {
      "enum": [
        "missing",
        "stale",
        "partial",
        "conflicting",
        "redacted",
        "lossy",
        "probe_failure"
      ],
      "title": "PropositionLossKind",
      "type": "string"
    },
    "PropositionProbeBindingModel": {
      "additionalProperties": false,
      "description": "Provenance for one capability-bound proposition realization.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "backend_manifest_ref": {
          "minLength": 1,
          "title": "Backend Manifest Ref",
          "type": "string"
        },
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "capability_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Refs",
          "type": "array"
        },
        "implementation_id": {
          "minLength": 1,
          "title": "Implementation Id",
          "type": "string"
        },
        "implementation_version": {
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "proposition_address": {
          "minLength": 1,
          "title": "Proposition Address",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "implementation_id",
        "implementation_version",
        "artifact_digest",
        "backend_manifest_ref",
        "proposition_address",
        "capability_refs"
      ],
      "title": "PropositionProbeBindingModel",
      "type": "object"
    },
    "PropositionTemporalContextModel": {
      "additionalProperties": false,
      "description": "Governed boundary and clock context used for one evaluation.",
      "properties": {
        "boundary_ref": {
          "minLength": 1,
          "title": "Boundary Ref",
          "type": "string"
        },
        "clock_authority": {
          "minLength": 1,
          "title": "Clock Authority",
          "type": "string"
        },
        "time_domain": {
          "minLength": 1,
          "title": "Time Domain",
          "type": "string"
        }
      },
      "required": [
        "boundary_ref",
        "time_domain",
        "clock_authority"
      ],
      "title": "PropositionTemporalContextModel",
      "type": "object"
    },
    "PropositionTruthOutcome": {
      "description": "Portable proposition-evaluation outcome domain.\n\n``unsupported`` is a realization disposition included in the portable\nenvelope, not a logical truth value.",
      "enum": [
        "true",
        "false",
        "unknown",
        "unsupported"
      ],
      "title": "PropositionTruthOutcome",
      "type": "string"
    }
  },
  "$id": "https://aces.dev/schemas/proposition-truth-result-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_basis": {
            "const": "observed_state"
          },
          "proposition_outcome": {
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "required": [
          "evaluation_basis",
          "proposition_outcome"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "probe_binding": {
            "not": {
              "type": "null"
            }
          },
          "temporal_context": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "indeterminacy_reason": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "proposition_outcome": {
            "const": "unknown"
          }
        },
        "required": [
          "proposition_outcome"
        ]
      },
      "then": {
        "properties": {
          "indeterminacy_reason": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "unsupported_capability_refs": {
            "maxItems": 0
          }
        }
      },
      "if": {
        "properties": {
          "proposition_outcome": {
            "const": "unsupported"
          }
        },
        "required": [
          "proposition_outcome"
        ]
      },
      "then": {
        "properties": {
          "unsupported_capability_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposition_outcome": {
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "required": [
          "proposition_outcome"
        ]
      },
      "then": {
        "properties": {
          "loss_disclosures": {
            "items": {
              "$ref": "#/$defs/PropositionLossDisclosureModel",
              "properties": {
                "within_admissible_bound": {
                  "const": true
                }
              },
              "required": [
                "within_admissible_bound"
              ]
            }
          }
        }
      }
    }
  ],
  "description": "Evidence-bearing truth result separate from evaluator lifecycle state.",
  "properties": {
    "assertion_address": {
      "minLength": 1,
      "title": "Assertion Address",
      "type": "string"
    },
    "assertion_outcome": {
      "$ref": "#/$defs/PropositionTruthOutcome"
    },
    "assertion_polarity": {
      "$ref": "#/$defs/PropositionAssertionPolarity"
    },
    "declared_artifact_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Artifact Digest"
    },
    "evaluation_basis": {
      "$ref": "#/$defs/PropositionEvaluationBasis"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "indeterminacy_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/PropositionIndeterminacyReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "loss_disclosures": {
      "items": {
        "$ref": "#/$defs/PropositionLossDisclosureModel"
      },
      "title": "Loss Disclosures",
      "type": "array"
    },
    "probe_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/PropositionProbeBindingModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposition_address": {
      "minLength": 1,
      "title": "Proposition Address",
      "type": "string"
    },
    "proposition_outcome": {
      "$ref": "#/$defs/PropositionTruthOutcome"
    },
    "result_id": {
      "minLength": 1,
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "proposition-truth-result/v1",
      "default": "proposition-truth-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "temporal_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/PropositionTemporalContextModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unsupported_capability_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unsupported Capability Refs",
      "type": "array"
    }
  },
  "required": [
    "result_id",
    "proposition_address",
    "assertion_address",
    "assertion_polarity",
    "proposition_outcome",
    "assertion_outcome",
    "evaluation_basis"
  ],
  "title": "PropositionTruthResultModel",
  "type": "object"
}
