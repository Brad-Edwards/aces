{
  "$defs": {
    "WorkflowStepAttemptProvenanceModel": {
      "additionalProperties": false,
      "properties": {
        "allowed_action_families": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Action Families",
          "type": "array"
        },
        "assertion_truth_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assertion Truth Refs",
          "type": "array"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_mode": {
          "enum": [
            "scripted",
            "objective",
            "scaffolded"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "exposed_scaffold_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exposed Scaffold Refs",
          "type": "array"
        },
        "fact_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Fact Versions",
          "type": "array"
        },
        "objective_address": {
          "default": "",
          "title": "Objective Address",
          "type": "string"
        },
        "outcome": {
          "default": "",
          "enum": [
            "",
            "succeeded",
            "failed",
            "exhausted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "participant_report": {
          "default": "",
          "title": "Participant Report",
          "type": "string"
        },
        "procedure_ref": {
          "default": "",
          "title": "Procedure Ref",
          "type": "string"
        },
        "selected_action_family": {
          "default": "",
          "title": "Selected Action Family",
          "type": "string"
        },
        "selected_affordance_ref": {
          "default": "",
          "title": "Selected Affordance Ref",
          "type": "string"
        },
        "selected_tool_ref": {
          "default": "",
          "title": "Selected Tool Ref",
          "type": "string"
        },
        "step_name": {
          "minLength": 1,
          "title": "Step Name",
          "type": "string"
        }
      },
      "required": [
        "step_name",
        "execution_mode",
        "attempt_id"
      ],
      "title": "WorkflowStepAttemptProvenanceModel",
      "type": "object"
    },
    "WorkflowStepStateModel": {
      "additionalProperties": false,
      "properties": {
        "attempt_provenance": {
          "items": {
            "$ref": "#/$defs/WorkflowStepAttemptProvenanceModel"
          },
          "title": "Attempt Provenance",
          "type": "array"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "lifecycle": {
          "title": "Lifecycle",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        }
      },
      "required": [
        "lifecycle",
        "attempts"
      ],
      "title": "WorkflowStepStateModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/workflow-result-envelope-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compensation_failures": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Compensation Failures",
      "type": "array"
    },
    "compensation_started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compensation Started At"
    },
    "compensation_status": {
      "title": "Compensation Status",
      "type": "string"
    },
    "compensation_updated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compensation Updated At"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "state_schema_version": {
      "const": "workflow-step-state/v1",
      "default": "workflow-step-state/v1",
      "title": "State Schema Version",
      "type": "string"
    },
    "steps": {
      "additionalProperties": {
        "$ref": "#/$defs/WorkflowStepStateModel"
      },
      "title": "Steps",
      "type": "object"
    },
    "terminal_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Reason"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "workflow_status": {
      "title": "Workflow Status",
      "type": "string"
    }
  },
  "required": [
    "workflow_status",
    "run_id",
    "started_at",
    "updated_at",
    "compensation_status"
  ],
  "title": "WorkflowExecutionStateModel",
  "type": "object"
}
