{
  "$id": "https://aces.dev/schemas/operation-status-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_addresses": {
      "items": {
        "maxLength": 2048,
        "minLength": 3,
        "not": {
          "pattern": "[^a-z0-9_.-]"
        },
        "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
        "type": "string"
      },
      "title": "Changed Addresses",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "runtime-operation/v1",
      "default": "runtime-operation/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "title": "State",
      "type": "string"
    },
    "submitted_at": {
      "title": "Submitted At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "domain",
    "state",
    "submitted_at",
    "updated_at"
  ],
  "title": "OperationStatusModel",
  "type": "object"
}
