              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Data Hash"
        },
        "raw_data_hash_algorithm": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
