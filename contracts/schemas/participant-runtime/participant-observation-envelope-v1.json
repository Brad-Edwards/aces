        "randomization_policy_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Policy Ref"
        },
        "seed_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
