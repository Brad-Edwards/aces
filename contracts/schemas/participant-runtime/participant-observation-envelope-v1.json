        },
        "raw_data_is_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Data Is Truncated"
        },
        "raw_data_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Data Size"
        },
        "raw_data_untruncated_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Data Untruncated Size"
        }
      },
      "title": "RawDataIntegrityModel",
      "type": "object"
    },
