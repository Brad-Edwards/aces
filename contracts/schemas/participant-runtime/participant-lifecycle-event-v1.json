      "default": null,
      "title": "Action Contract Ref"
    },
    "action_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Ref"
    },
    "action_validity_basis_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Validity Basis Ref"
    },
    "actor_provenance": {
      "minLength": 1,
      "title": "Actor Provenance",
      "type": "string"
