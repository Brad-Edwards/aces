    "markings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Markings",
      "type": "array"
    },
    "object_marking_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Object Marking Refs",
      "type": "array"
    },
    "observation_refs": {
