  "required": [
    "event_id",
    "schema_name",
    "schema_version",
    "event_type",
    "extension_policy",
    "occurred_at",
    "recorded_at",
    "ingested_at",
    "clock_authority",
    "ordering_basis",
    "actor_ref",
    "producer_ref",
    "authorization_scope",
    "phase",
    "phase_realization",
    "actor_provenance"
