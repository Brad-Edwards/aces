            "redacted_by_policy",
            "temporal_detail_collapsed",
            "unknown",
            "unsupported"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Loss"
    },
    "mapping_loss_detail": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Loss Detail"
    },
    "marking_definition_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Marking Definition Refs",
      "type": "array"
